# VideoAssistant shared example. Copy this file to .env; never commit your .env.
# PowerShell: Copy-Item .env.example .env
# macOS/Linux: cp .env.example .env
# Existing OS environment variables override values in .env.
VIDEO_ASSISTANT_RUNTIME_DIR=runtime
MAX_UPLOAD_MB=200

# Default startup is safe to run without real AI providers.
TRANSCRIBER_BACKEND=stub
ANALYZER_BACKEND=stub
RECOMMENDER_BACKEND=stub
EDITOR_BACKEND=stub

# Already available learning implementations:
# ANALYZER_BACKEND=simple
# RECOMMENDER_BACKEND=keyword
# Real whisper/llm/ffmpeg backends must be implemented and registered first.
# Put API keys in your personal .env only, not here.
