# OS/shell environment variables have priority over this file.
RUNTIME_DIR=runtime

TRANSCRIBER_BACKEND=whisper
PREPROCESSOR_BACKEND=ai
ANALYZER_BACKEND=llm
PROJECT_ANALYZER_BACKEND=stub
RECOMMENDER_BACKEND=stub
EDITOR_BACKEND=stub

# Comma-separated React frontend origins (scheme + host + port).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=ko

# AI
AI_PROVIDER=gemini
AI_FALLBACK=raise
GEMINI_API_KEY=여기에_기존_실제_키_유지
# Gemini 자막 교정 동시 요청 수 (1: 순차, 기본 3, 허용 1~8)
PREPROCESSING_CONCURRENCY=3

# 일시적 오류 시 배치별 추가 재시도 횟수 (0: 재시도 없음, 허용 0~5)
PREPROCESSING_MAX_RETRIES=2
