# 실행 환경
RUNTIME_DIR=runtime
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 구현체 선택 (Gemini 자막 교정 사용 시 PREPROCESSOR_BACKEND=ai)
TRANSCRIBER_BACKEND=whisper
PREPROCESSOR_BACKEND=rule_based
ANALYZER_BACKEND=llm
PROJECT_ANALYZER_BACKEND=stub
# llm: AI_PROVIDER에 따른 실제 추천 / stub: 검색 의미와 무관한 테스트 추천
RECOMMENDER_BACKEND=llm
EDITOR_BACKEND=ffmpeg

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=ko

# AI 공통
AI_PROVIDER=gemini
AI_FALLBACK=raise
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=300

# Gemini 자막 교정
PREPROCESSING_CONCURRENCY=3
PREPROCESSING_MAX_RETRIES=2
PREPROCESSING_THINKING_LEVEL=low
PREPROCESSING_BATCH_SEGMENTS=16
PREPROCESSING_BATCH_CHARACTERS=6000

# Gemini 영상 분석
ANALYSIS_THINKING_LEVEL=medium

# Experimental: enable only after comparing latency and analysis quality.
ANALYSIS_PARALLEL_ENABLED=false
ANALYSIS_CONCURRENCY=3
ANALYSIS_BATCH_SEGMENTS=64
ANALYSIS_BATCH_CHARACTERS=12000
ANALYSIS_OVERLAP_SEGMENTS=3
ANALYSIS_PARALLEL_THRESHOLD=96
ANALYSIS_PARALLEL_THRESHOLD_CHARACTERS=24000

# Independent Map / Reduce recovery (single analysis keeps ANALYSIS_THINKING_LEVEL)
ANALYSIS_MAP_THINKING_LEVEL=low
ANALYSIS_REDUCE_THINKING_LEVEL=medium
ANALYSIS_MAP_TIMEOUT_SECONDS=120
ANALYSIS_REDUCE_TIMEOUT_SECONDS=120
ANALYSIS_MAP_MAX_RETRIES=2
ANALYSIS_REDUCE_MAX_RETRIES=2
ANALYSIS_RETRY_BASE_DELAY_SECONDS=2
ANALYSIS_RETRY_MAX_DELAY_SECONDS=15
# Validated Map results under RUNTIME_DIR/analysis_cache; disable for cold benchmarks.
ANALYSIS_CACHE_ENABLED=true
