# 실행 환경
RUNTIME_DIR=runtime
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 구현체 선택 (Gemini 자막 교정 사용 시 PREPROCESSOR_BACKEND=ai)
TRANSCRIBER_BACKEND=whisper
PREPROCESSOR_BACKEND=rule_based
ANALYZER_BACKEND=llm
PROJECT_ANALYZER_BACKEND=stub
RECOMMENDER_BACKEND=stub
EDITOR_BACKEND=stub

# Whisper
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_LANGUAGE=ko

# AI 공통
AI_PROVIDER=gemini
AI_FALLBACK=raise
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_SECONDS=300

# Gemini 자막 교정
PREPROCESSING_CONCURRENCY=3
PREPROCESSING_MAX_RETRIES=2
PREPROCESSING_THINKING_LEVEL=low
PREPROCESSING_BATCH_SEGMENTS=16
PREPROCESSING_BATCH_CHARACTERS=6000

# Gemini 영상 분석
ANALYSIS_THINKING_LEVEL=medium
